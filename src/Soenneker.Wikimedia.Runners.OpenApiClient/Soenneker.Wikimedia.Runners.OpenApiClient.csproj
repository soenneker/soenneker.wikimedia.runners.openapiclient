<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A runner that regenerates and updates Soenneker.Wikimedia.OpenApiClient.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Wikimedia.Runners.OpenApiClient</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Cloudflare.Downloader" Version="4.0.443" />
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="4.0.1442" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Soenneker.Kiota.Util" Version="4.0.167" />
        <PackageReference Include="Soenneker.Managers.Runners" Version="4.0.2646" />
        <PackageReference Include="Soenneker.OpenApi.Fixer" Version="4.0.401" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Enums.DeployEnvironment" Version="4.0.260" />
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.133" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.String" Version="4.0.800" />
    </ItemGroup>
</Project>
